# Production: PostgreSQL or a Supabase PostgreSQL connection string
DATABASE_URL=postgresql://stitchr:stitchr@localhost:5432/stitchr
# Use REGISTRY_DRIVER=pglite only for a local embedded PostgreSQL sandbox.
REGISTRY_DRIVER=postgres
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Explicit deterministic demo interpreter; production requires OpenAI.
REQUIREMENTS_MODE=openai
